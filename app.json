{
  "expo": {
    "name": "Ritmo",
    "slug": "ritmo",
    "version": "0.0.2",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "scheme": "ritmo",
    "icon": "./assets/icon/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": ["android", "ios"],
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/icon/splash-icon-dark.png",
            "backgroundColor": "#121512"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon/notification-icon.png",
          "color": "#3368A0"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.ritmo.app"
    },
    "android": {
      "package": "com.ritmo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-foreground.png",
        "monochromeImage": "./assets/icon/adaptive-monochrome.png",
        "backgroundColor": "#121512"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5f447cd-1534-4862-af3c-50e003e526f8"
      }
    },
    "owner": "rodrigoge",
    "updates": {
      "url": "https://u.expo.dev/b5f447cd-1534-4862-af3c-50e003e526f8",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
