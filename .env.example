# Copie para .env e preencha. Passo a passo em supabase/README.md.

# Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google Cloud > APIs & Services > Credentials
# Client ID do tipo "Web application" (o mesmo cadastrado no Supabase).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxx.apps.googleusercontent.com
# Somente para iOS: Client ID do tipo "iOS" e o mesmo valor invertido.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
